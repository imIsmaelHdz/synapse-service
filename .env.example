# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL — Railway injects this automatically
DATABASE_URL=postgresql://user:password@localhost:5432/synapse

# Firebase Admin SDK
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Gemini — AI suggestions + discovery
# aistudio.google.com → Get API key
GEMINI_API_KEY=AIza...

# Database encryption key — AES-256-GCM for sensitive note fields at rest
# Generate once with: openssl rand -hex 32
# NEVER rotate this after data is written — you will lose all note content.
# Back up this value securely (password manager, etc.)
DB_ENCRYPTION_KEY=your-64-char-hex-key-here
