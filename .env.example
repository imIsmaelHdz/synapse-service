# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL — Railway injects this automatically
DATABASE_URL=postgresql://user:password@localhost:5432/synapse

# Local dev only — mock Firebase auth with Bearer dev:<uid>:<email>:<name>
# DEV_AUTH_BYPASS=true

# Firebase Admin SDK
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Anthropic — Claude API for AI suggestions
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
